# The project uses pnpm (see "packageManager" in package.json), which
# resolves peer dependencies leniently by default. Plain `npm install` is
# stricter and fails with ERESOLVE because @builder.io/vite-plugin-jsx-loc
# declares a peer range of vite ^4/^5 while the project uses vite ^7 (the
# plugin works fine with vite 7 in practice; its peer range just hasn't been
# updated). This setting makes `npm install` behave the same way pnpm does
# here, so installing with either package manager works without extra flags.
legacy-peer-deps=true
