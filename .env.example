# =============================================================================
# Capstone Archive — environment settings
# Copy this file to ".env" and fill in the values. Restart the server after changes.
# =============================================================================

# Server mode and port. Use "production" when the system is deployed for real use.
NODE_ENV=development
PORT=8080

# Secret used to sign login sessions. Use a long random value
# (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# The server refuses to start in production without it.
JWT_SECRET=replace-with-a-long-random-string

# App identifier stored inside login sessions (any short name).
VITE_APP_ID=capstone-archive

# -----------------------------------------------------------------------------
# Sign-in is by School ID + password (see the Sign Up page). There is no Google
# sign-in and no demo login — everyone, including the first librarian, creates
# their account from /signup. Nothing to configure here.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# MySQL database (Drizzle ORM). setup-database.bat fills this in for you.
# XAMPP default: user root, no password -> mysql://root@localhost:3306/capstone_archive
# With a password: mysql://root:YOURPASSWORD@localhost:3306/capstone_archive
# Leave empty to store data in local_db.json instead (demo mode).
# -----------------------------------------------------------------------------
DATABASE_URL=

# Optional: external file storage. Leave blank to keep uploads in the ./uploads folder.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
