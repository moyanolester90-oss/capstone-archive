# Google OAuth Authentication Configuration
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a new project or select an existing one.
# 3. Go to "APIs & Services" > "OAuth consent screen" and configure it.
# 4. Go to "Credentials" > "Create Credentials" > "OAuth client ID".
# 5. Application type: Web application.
# 6. Authorized redirect URIs:
#    - http://localhost:3000/api/oauth/callback (for local development)
#    - https://yourdomain.com/api/oauth/callback (for production)
# 7. Copy Client ID and Client Secret here.

# Google OAuth Variables
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/callback"

# Secret key for local JWT session cookie signing (Generate via: openssl rand -hex 32)
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# OpenID of the account to assign administrator role upon first sign-in
# For Google OAuth, this is the 'sub' field (Google User ID).
OWNER_OPEN_ID=""

# Server Environment & Port
NODE_ENV=development
PORT=3000

# Optional: MySQL Database Connection URL
# If empty, the application uses local_db.json for storage.
DATABASE_URL=""

# Optional: Built-in Forge API fallback (Leave blank for 100% self-hosted disk storage)
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""
